## 🔧 Customization Guide

### Adding New KPIs
javascript
// Add to KPI cards section in HTML
<div class="kpi-card">
    <h3>Your New Metric</h3>
    <div class="kpi-value" id="newMetric">$XXX</div>
    <div class="kpi-change positive">↗ +X% vs last period</div>
</div>


### Creating New Charts
javascript
// Initialize new chart
function initYourChart() {
    const ctx = document.getElementById('yourChart').getContext('2d');
    charts.yourChart = new Chart(ctx, {
        type: 'bar', // or 'line', 'pie', 'doughnut', etc.
        data: yourData,
        options: yourOptions
    });
}


